{
  "name": "@creatioart/template-nodejs-express-service",
  "version": "1.4.2",
  "private": true,
  "description": "CreatioART - Template Node.js Express Service able to handle API's request",
  "keywords": [
    "template",
    "service",
    "nodejs",
    "express"
  ],
  "homepage": "https://docs.creatioart.com/template/template-nodejs-express-service",
  "repository": {
    "type": "git",
    "url": "https://creatioart@dev.azure.com/creatioart/template/_git/template-nodejs-express-service"
  },
  "license": "Apache-2.0",
  "author": "CreatioART - CreatioART Support <support@creatioart.com>",
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:clean": "rimraf ./build/",
    "build:format": "npm run mdformat",
    "build:lint": "npx eslint ./src/** --max-warnings=0 --config=.eslintrc.json",
    "build:compile": "tsc",
    "build:locale": "npm run locale",
    "mdformat": "npx prettier --write *.md",
    "prewatch": "npm run build",
    "watch": "npm run prewatch -- -w",
    "start": "node ./build/app.js",
    "dev": "npm run build && cross-env APP_ENV=local npm run start",
    "debug": "npm run build && cross-env DEBUG=true APP_ENV=local npm run start",
    "start:watch": "npm run watch & nodemon ./build/app.js",
    "test": "npm-run-all test:*",
    "test:build": "npm run build",
    "test:clean": "rimraf ./coverage/",
    "test:lint": "npx eslint ./test/** --max-warnings=0 --config=.eslintrc.json",
    "test:start": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --config=jest.config.json --no-cache --silent",
    "tdd": "nodemon -e ts --watch ./test --exec \"npm run test\"",
    "prepare": "husky",
    "locale": "npx locale-compiler -s ./locales/source -t ./locales/compiled"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "npx eslint ./src --max-warnings=0 --config=.eslintrc.json && npm run locale",
    "*.md": "npx prettier --write *.md"
  },
  "nodemonConfig": {
    "exec": "node_modules/.bin/ts-node ./src/index.ts",
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@creatioart-js/express-core": "^1.4.0",
    "@creatioart-js/express-error": "^1.4.0",
    "@creatioart-js/express-error-handler": "^1.4.0",
    "@creatioart-js/express-logging": "^1.4.0",
    "@creatioart-js/express-security": "^1.4.0",
    "@creatioart-js/express-service": "^1.4.0",
    "@creatioart-js/express-storage": "^1.4.0",
    "@creatioart-js/routing-controllers": "^0.11.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "glob": "^11.0.2",
    "i18n": "^0.15.1",
    "morgan": "^1.10.0",
    "reflect-metadata": "0.2.2",
    "typedi": "0.10.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@npm/types": "^2.1.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/i18n": "^0.13.12",
    "@types/node": "^22.15.17",
    "@types/uuid": "^10.0.0",
    "@types/eslint": "<9.0.0",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/validator": "^13.15.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "cross-env": "^7.0.3",
    "eslint": "<9.0.0",
    "eslint-plugin-n": "^17.18.0",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.0.0",
    "madge": "^8.0.0",
    "nock": "^14.0.4",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "20.x.x"
  }
}
